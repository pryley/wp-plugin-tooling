#!/usr/bin/env php
<?php

/*
 * A command that bumps the plugin version in composer.json, the Stable tag of readme.txt and
 * the Version header of the main plugin file. Run it from the plugin's root.
 *
 *     bump [patch|minor|major|beta] [--dry-run] [--plugin-file=my-plugin.php]
 *
 * The current version is read from the Stable tag, like VERSION in plugin.mk.
 * The main plugin file defaults to the folder's name with .php, as WordPress names it.
 *
 * beta goes 8.2.0 -> 8.2.1-beta1 -> 8.2.1-beta2, and patch then makes 8.2.1. A plain -N
 * suffix such as 8.2.1-2 becomes 8.2.1-beta1 with beta and 8.2.1 with patch.
 */

$root = (string) getcwd();
$args = array_slice($_SERVER['argv'] ?? [], 1);
$dryRun = in_array('--dry-run', $args, true);
$pluginFile = basename($root).'.php';
foreach ($args as $arg) {
    if (str_starts_with($arg, '--plugin-file=')) {
        $pluginFile = substr($arg, strlen('--plugin-file='));
    }
}
$args = array_values(array_filter($args, fn ($arg) => !str_starts_with($arg, '--')));
$type = $args[0] ?? 'patch';
if (!in_array($type, ['beta', 'major', 'minor', 'patch'], true)) {
    fwrite(STDERR, "Unknown bump type [{$type}] — use patch, minor, major, or beta.\n");
    exit(1);
}

$readme = file_get_contents("{$root}/readme.txt");
if (!preg_match('/^Stable tag:\s*(\S+)/m', (string) $readme, $matches)) {
    fwrite(STDERR, "No Stable tag found in readme.txt.\n");
    exit(1);
}
$current = $matches[1];
if (!preg_match('/^(\d+)\.(\d+)\.(\d+)(?:-([a-z]*)(\d+))?$/', $current, $parts)) {
    fwrite(STDERR, "Cannot parse the current version [{$current}].\n");
    exit(1);
}
[, $major, $minor, $patch] = $parts;
$preLabel = isset($parts[5]) ? $parts[4] : null; // '' for a plain -N prerelease
$preNum = isset($parts[5]) ? (int) $parts[5] : null;

switch ($type) {
    case 'major':
        $next = sprintf('%d.0.0', $major + 1);
        break;
    case 'minor':
        $next = sprintf('%d.%d.0', $major, $minor + 1);
        break;
    case 'beta':
        if (null === $preNum) {
            $next = sprintf('%d.%d.%d-beta1', $major, $minor, $patch + 1);
        } elseif ('beta' === $preLabel) {
            $next = sprintf('%d.%d.%d-beta%d', $major, $minor, $patch, $preNum + 1);
        } else { // a plain -N prerelease adopts the beta name at the same version
            $next = sprintf('%d.%d.%d-beta1', $major, $minor, $patch);
        }
        break;
    default: // patch; a prerelease of either kind finalizes to its release version
        $next = null === $preNum
            ? sprintf('%d.%d.%d', $major, $minor, $patch + 1)
            : sprintf('%d.%d.%d', $major, $minor, $patch);
        break;
}

$replacements = [
    'composer.json' => ['/("version":\s*")[^"]+(")/', '${1}'.$next.'${2}'],
    'readme.txt' => ['/^(Stable tag:\s*)\S+/m', '${1}'.$next],
    $pluginFile => ['/^(\s*\*\s*Version:\s*)\S+/m', '${1}'.$next],
];
$updates = []; // every file is checked before any is written
foreach ($replacements as $file => [$pattern, $replace]) {
    $path = "{$root}/{$file}";
    if (!is_file($path)) {
        fwrite(STDERR, "No {$file} in {$root} — nothing written.\n");
        exit(1);
    }
    $updated = preg_replace($pattern, $replace, (string) file_get_contents($path), 1, $count);
    if (1 !== $count) {
        fwrite(STDERR, "No version key found in {$file} — nothing written.\n");
        exit(1);
    }
    $updates[$path] = $updated;
}
foreach ($updates as $path => $updated) {
    if (!$dryRun) {
        file_put_contents($path, $updated);
    }
    printf("%s%s: %s -> %s\n", $dryRun ? '[dry-run] ' : '', basename($path), $current, $next);
}
